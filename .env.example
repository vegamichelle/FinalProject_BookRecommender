# Copy to .env and fill in for production. Local dev works with the defaults.

# --- AWS / DynamoDB ---
AWS_REGION=us-east-1
DDB_LOGS_TABLE=book-rec-logs
DDB_CACHE_TABLE=book-rec-cache
# Set DDB_LOCAL=0 in production (needs AWS creds via the EC2 IAM role).
DDB_LOCAL=1
CACHE_ENABLED=1

# --- Model source ---
# local -> load artifacts/recommender.joblib ; wandb -> pull from Model Registry
MODEL_SOURCE=local
MODEL_LOCAL_PATH=artifacts/recommender.joblib

# --- Weights & Biases ---
WANDB_PROJECT=mlops-book-recommender
WANDB_ENTITY=your-wandb-username
WANDB_MODEL_NAME=book-recommender
WANDB_MODEL_ALIAS=production
# WANDB_API_KEY is read by the wandb library; set it in the shell / EC2 env.

# --- Recommender ---
DEFAULT_TOP_N=10
SIM_TOP_K=50
MIN_INTERACTIONS=3

# --- Frontend ---
BACKEND_URL=http://localhost:8000
